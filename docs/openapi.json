{
  "openapi": "3.1.0",
  "info": {
    "title": "Sensor Ingestion API",
    "description": "Ingests IoT sensor readings and reports device status. Every error is an RFC 9457 problem (application/problem+json).",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readings": {
      "post": {
        "summary": "Submit a reading",
        "operationId": "create_reading_readings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Stored. `Location` points to the new reading.",
            "headers": {
              "Location": {
                "description": "/readings/{id}",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingOut"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay: an identical reading (same device_id, timestamp and values) was already stored. Nothing new is written; the stored reading is returned.",
            "headers": {
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingOut"
                }
              }
            }
          },
          "409": {
            "description": "Same device_id and timestamp as a stored reading, but different values",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited: a burst of 5 readings per device, refilled at 1 per second",
            "headers": {
              "Retry-After": {
                "description": "Seconds until a request is allowed again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Server error; nothing stored. Safe to retry (idempotent)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/readings/{reading_id}": {
      "get": {
        "summary": "Get Reading",
        "operationId": "get_reading_readings__reading_id__get",
        "parameters": [
          {
            "name": "reading_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Reading Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingOut"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/devices": {
      "get": {
        "summary": "List Devices",
        "operationId": "list_devices_devices_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ok",
                    "anomaly",
                    "stale"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/devices/{device_id}": {
      "get": {
        "summary": "Get Device",
        "operationId": "get_device_devices__device_id__get",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^dev-\\d{3}$",
              "examples": [
                "dev-001"
              ],
              "title": "Device Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/devices/{device_id}/readings": {
      "get": {
        "summary": "List Device Readings",
        "operationId": "list_device_readings_devices__device_id__readings_get",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^dev-\\d{3}$",
              "examples": [
                "dev-001"
              ],
              "title": "Device Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "anomalies_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Anomalies Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceReadings"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/anomalies": {
      "get": {
        "summary": "List Anomalies",
        "operationId": "list_anomalies_anomalies_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomalyList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/admin/faults": {
      "get": {
        "summary": "Get Faults",
        "operationId": "get_faults_admin_faults_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaultConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Put Faults",
        "operationId": "put_faults_admin_faults_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaultConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Faults",
        "operationId": "delete_faults_admin_faults_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaultConfig"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnomalyList": {
        "properties": {
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingOut"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "readings"
        ],
        "title": "AnomalyList"
      },
      "DeviceList": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceStatus"
            },
            "type": "array",
            "title": "Devices"
          }
        },
        "type": "object",
        "required": [
          "count",
          "devices"
        ],
        "title": "DeviceList"
      },
      "DeviceReadings": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingOut"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "readings"
        ],
        "title": "DeviceReadings"
      },
      "DeviceStatus": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "anomaly",
              "stale"
            ],
            "title": "Status"
          },
          "first_seen": {
            "type": "string",
            "title": "First Seen"
          },
          "last_seen": {
            "type": "string",
            "title": "Last Seen"
          },
          "reading_count": {
            "type": "integer",
            "title": "Reading Count"
          },
          "anomaly_count": {
            "type": "integer",
            "title": "Anomaly Count"
          },
          "latest_reading": {
            "$ref": "#/components/schemas/ReadingOut"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "status",
          "first_seen",
          "last_seen",
          "reading_count",
          "anomaly_count",
          "latest_reading"
        ],
        "title": "DeviceStatus"
      },
      "FaultConfig": {
        "properties": {
          "delay_ms": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "description": "Extra latency added to affected requests",
            "default": 0
          },
          "delay_every_n": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Delay Every N",
            "description": "Delay every Nth POST /readings (1 = every request)",
            "default": 1
          },
          "error_every_n": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Error Every N",
            "description": "Fail every Nth POST /readings with 500 (0 = off)",
            "default": 0
          }
        },
        "type": "object",
        "title": "FaultConfig"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable identifier of the problem kind, e.g. urn:sensor-api:problem:validation-error, :reading-conflict, :rate-limited, :not-found, :internal-error"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "HTTP status phrase, e.g. Conflict"
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP status code, repeated in the body"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What went wrong for this request, in words"
          },
          "instance": {
            "type": "string",
            "title": "Instance",
            "description": "Path of the request that failed"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Same value as the X-Request-ID response header; search the logs for it"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemFieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Field-level errors (422 only)"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem details: the body of every error response (application/problem+json)."
      },
      "ProblemFieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field",
            "description": "e.g. humidity_pct, or path.device_id for a path parameter"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Pydantic error type, e.g. less_than_equal, missing, timestamp_in_future"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "type",
          "message"
        ],
        "title": "ProblemFieldError"
      },
      "ReadingIn": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^dev-\\d{3}$",
            "title": "Device Id",
            "examples": [
              "dev-001"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Device clock, with timezone, e.g. 2026-09-26T10:00:00Z"
          },
          "temperature_c": {
            "type": "number",
            "maximum": 85.0,
            "minimum": -40.0,
            "title": "Temperature C"
          },
          "humidity_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Humidity Pct"
          },
          "battery_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Battery Pct"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "timestamp",
          "temperature_c",
          "humidity_pct",
          "battery_pct"
        ],
        "title": "ReadingIn"
      },
      "ReadingOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "received_at": {
            "type": "string",
            "title": "Received At"
          },
          "temperature_c": {
            "type": "number",
            "title": "Temperature C"
          },
          "humidity_pct": {
            "type": "number",
            "title": "Humidity Pct"
          },
          "battery_pct": {
            "type": "number",
            "title": "Battery Pct"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly"
          },
          "anomaly_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Anomaly Reasons"
          }
        },
        "type": "object",
        "required": [
          "id",
          "device_id",
          "timestamp",
          "received_at",
          "temperature_c",
          "humidity_pct",
          "battery_pct",
          "is_anomaly",
          "anomaly_reasons"
        ],
        "title": "ReadingOut"
      }
    }
  }
}
